{% comment %}
  ARVI Physical Luxury Boutiques Showcase (Melano, Lugano, Zurich)
  Compatible with Shopify Dawn 16.0+
{% endcomment %}

<section class="arvi-boutiques-section">
  <div class="arvi-section-header">
    <span class="arvi-section-kicker">Exclusive Destinations</span>
    <h2 class="arvi-section-title">The Arvino Luxury Wine Boutiques</h2>
    <p class="arvi-section-desc">
      Step into an atmosphere of quiet opulence, where rare vintages meet personalized sommelier guidance. Experience ARVI in Switzerland’s most prestigious locations.
    </p>
  </div>

  <div class="arvi-boutiques-grid">
    <!-- Melano Boutique -->
    <div class="arvi-boutique-card">
      <div class="arvi-boutique-image-wrap">
        <img 
          src="https://arvi.ch/images/uploaded/Melano.png" 
          alt="Arvino Melano Headquarters and Central Wine Vault"
          loading="lazy"
        >
        <div class="arvi-boutique-city-badge">Melano • Headquarters</div>
      </div>
      <div class="arvi-boutique-body">
        <h3 class="arvi-boutique-name">Arvino Melano & Central Vault</h3>
        <p class="arvi-boutique-highlight">
          Nestled along Lake Lugano, our central facility houses over 10,000 distinct labels ready for immediate worldwide dispatch or private cellar pickup.
        </p>
        <ul class="arvi-boutique-meta-list">
          <li>
            <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            <span>Via Pedemonte di Sopra 1, 6818 Melano</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            <span>Mon - Fri: 8:30–12:30 / 13:00–18:00</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <span>+41 91 649 68 88</span>
          </li>
        </ul>
        <a href="#sommelierModal" data-arvi-modal="sommelier" class="arvi-btn-secondary">Book Private Cellar Visit</a>
      </div>
    </div>

    <!-- Lugano Boutique -->
    <div class="arvi-boutique-card">
      <div class="arvi-boutique-image-wrap">
        <img 
          src="https://arvi.ch/images/uploaded/Lugano.png" 
          alt="Arvino Lugano Luxury Wine Boutique"
          loading="lazy"
        >
        <div class="arvi-boutique-city-badge">Lugano • Boutique</div>
      </div>
      <div class="arvi-boutique-body">
        <h3 class="arvi-boutique-name">Arvino Lugano</h3>
        <p class="arvi-boutique-highlight">
          An intimate, sophisticated salon in the heart of Lugano offering rare allocations, crystal glassware by Zalto, and private tasting sessions with our sommeliers.
        </p>
        <ul class="arvi-boutique-meta-list">
          <li>
            <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            <span>Via Emilio Bossi 1, 6900 Lugano</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            <span>Tue - Sat: 10:00 - 19:00</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <span>+41 91 924 94 88</span>
          </li>
        </ul>
        <a href="#sommelierModal" data-arvi-modal="sommelier" class="arvi-btn-secondary">Reserve Sommelier Tasting</a>
      </div>
    </div>

    <!-- Zurich Boutique -->
    <div class="arvi-boutique-card">
      <div class="arvi-boutique-image-wrap">
        <img 
          src="https://arvi.ch/images/uploaded/Zurigo.png" 
          alt="Arvino Zurich Luxury Wine Shop"
          loading="lazy"
        >
        <div class="arvi-boutique-city-badge">Zurich • Financial District</div>
      </div>
      <div class="arvi-boutique-body">
        <h3 class="arvi-boutique-name">Arvino Zurich</h3>
        <p class="arvi-boutique-highlight">
          Steps from Bahnhofstrasse, our Zurich boutique hosts standing tastings up to 40 guests and bespoke private dinners for 18 at our iconic central tasting table.
        </p>
        <ul class="arvi-boutique-meta-list">
          <li>
            <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            <span>Sankt Annagasse 9, 8001 Zurich</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            <span>Mon - Sat: 10:00 - 18:00</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <span>+41 43 810 08 88</span>
          </li>
        </ul>
        <a href="#sommelierModal" data-arvi-modal="sommelier" class="arvi-btn-secondary">Host Private Dinner / Event</a>
      </div>
    </div>
  </div>
</section>

