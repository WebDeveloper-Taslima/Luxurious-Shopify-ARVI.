          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </div>
      <div class="arvi-trust-text">
        <h3>Swiss Tax-Free & 24h Transit</h3>
        <p>Bonded warehouse storage & temperature-controlled insured express shipping.</p>
      </div>
    </div>

    <div class="arvi-trust-card">
      <div class="arvi-trust-icon-box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M8 21h8M12 17v4M12 3a7 7 0 0 1 7 7c0 4-3 7-7 7s-7-3-7-7a7 7 0 0 1 7-7z"/>
        </svg>
      </div>
      <div class="arvi-trust-text">
        <h3>Private Sommelier Advisory</h3>
        <p>Tailored portfolio curation and private tastings at our Zurich, Lugano & Melano shops.</p>
      </div>
    </div>
  </div>
</div>

