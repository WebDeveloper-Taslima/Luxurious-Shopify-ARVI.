{% comment %}
  ARVI Swiss Luxury Trust & Value Propositions Bar
  Compatible with Shopify Dawn 16.0+
{% endcomment %}

<div class="arvi-trust-bar">
  <div class="arvi-trust-grid">
    <div class="arvi-trust-card">
      <div class="arvi-trust-icon-box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div class="arvi-trust-text">
        <h3>100% Provenance Guaranteed</h3>
        <p>Direct châteaux allocations, verified bottles, and pristine single-owner cellar history.</p>
      </div>
    </div>

    <div class="arvi-trust-card">
      <div class="arvi-trust-icon-box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
        </svg>
      </div>
      <div class="arvi-trust-text">
        <h3>Subterranean Climate Vault</h3>
        <p>Constant 12°C & 70% humidity in our purpose-built Melano cellar with 10,000+ labels.</p>
      </div>
    </div>

    <div class="arvi-trust-card">
      <div class="arvi-trust-icon-box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
